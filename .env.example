# Spotify Web API (server-only — NEVER prefix with NEXT_PUBLIC_)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=TR
SPOTIFY_REVALIDATE_SECONDS=21600

# Site
# Prod'da (Vercel) bunu gerçek özel alan adına ayarla — sitemap.xml,
# robots.txt, canonical ve og:url buradan üretilir.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DEPLOY_TARGET=vercel
NEXT_PUBLIC_BASE_PATH=

# Google Search Console doğrulama kodu (isteğe bağlı)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Mağaza yönetim paneli (/admin) — server-only, gerçek değerleri sadece
# .env.local ve Vercel proje ayarlarına gir, asla commit etme.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GitHub Pages mirror mode:
# NEXT_PUBLIC_DEPLOY_TARGET=github-pages
# NEXT_PUBLIC_BASE_PATH=/sehinsah-dijital-evren
# NEXT_PUBLIC_SITE_URL=https://R0YC0LD.github.io/sehinsah-dijital-evren
