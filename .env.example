# Spotify Web API (server-only — never use NEXT_PUBLIC_ for secrets)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=TR
SPOTIFY_REVALIDATE_SECONDS=21600

# embed | api  (default: embed — Development Mode safe)
SPOTIFY_TOP_TRACKS_MODE=embed

# Site URL for metadata / sitemap
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional: static GitHub Pages export
# NEXT_OUTPUT=export
# NEXT_PUBLIC_BASE_PATH=/sehinsah-dijital-evren
